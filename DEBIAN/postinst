#!/bin/bash
set -e

PKG=linuwu-sense
VER=2.0.0
OLDPKG=predatortune

case "$1" in
configure)
    # ---------------------------------------------------------------
    # Kernel module, via DKMS.
    #
    # The old packaging dropped a prebuilt .ko in /usr/lib/predatortune,
    # which modprobe never looks at, so the boot-time load always failed
    # and the module had to be insmod'ed by hand after every kernel
    # update. DKMS rebuilds it for whatever kernel is running, including
    # kernels installed later.
    # ---------------------------------------------------------------
    if command -v dkms >/dev/null 2>&1; then
        # Retire the old standalone fan module: linuwu_sense drives the same
        # WMI methods, and two drivers fighting over them helps nobody.
        if dkms status -m "$OLDPKG" -v "$VER" 2>/dev/null | grep -q .; then
            dkms remove -m "$OLDPKG" -v "$VER" --all >/dev/null 2>&1 || true
        fi
        rm -rf "/usr/src/$OLDPKG-$VER"
        # rmmod, not modprobe -r: by now DKMS has taken the .ko away, so
        # modprobe cannot resolve the name even though it is still resident.
        rmmod predatortune_fan 2>/dev/null || true

        # Drop any half-registered copy from a previous install first.
        if dkms status -m "$PKG" -v "$VER" 2>/dev/null | grep -q .; then
            dkms remove -m "$PKG" -v "$VER" --all >/dev/null 2>&1 || true
        fi

        if dkms add -m "$PKG" -v "$VER" >/dev/null 2>&1 &&
           dkms build -m "$PKG" -v "$VER" >/dev/null 2>&1 &&
           dkms install -m "$PKG" -v "$VER" --force >/dev/null 2>&1; then
            echo "linuwu_sense built and installed for $(uname -r)"
        else
            echo "WARNING: DKMS build failed. Fan speed, battery limit and" >&2
            echo "         keyboard colour will be unavailable. Check:" >&2
            echo "           dkms build -m $PKG -v $VER" >&2
            echo "         (is linux-headers-$(uname -r) installed?)" >&2
        fi
        depmod -a || true
    else
        echo "WARNING: dkms is not installed, the module cannot be built" >&2
    fi

    # Swap the drivers now so nothing has to wait for a reboot. linuwu_sense
    # is a fork of acer_wmi and claims the same platform device, so the
    # in-tree one has to go first.
    modprobe -r acer_wmi 2>/dev/null || true
    modprobe linuwu_sense 2>/dev/null || true

    udevadm control --reload-rules 2>/dev/null || true
    # Open up the new attributes for the tray and window straight away.
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/predatortune.conf 2>/dev/null || true

    if [ ! -e /sys/devices/platform/acer-wmi/predator_sense/fan_speed ]; then
        echo "WARNING: linuwu_sense did not take over. Fan control, the" >&2
        echo "         battery limiter and keyboard colour need it." >&2
        if grep -q '\[integrity\]\|\[confidentiality\]' \
             /sys/kernel/security/lockdown 2>/dev/null; then
            echo "         Secure Boot is on: enrol this machine's key with" >&2
            echo "           sudo mokutil --import /var/lib/shim-signed/mok/MOK.der" >&2
            echo "         then reboot and choose Enroll MOK." >&2
        fi
    fi

    # ---------------------------------------------------------------
    # Services
    # ---------------------------------------------------------------
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable --now predatortune-daemon.service 2>/dev/null || true
    systemctl enable predatortune-resume.service 2>/dev/null || true

    # ---------------------------------------------------------------
    # Tray, for whoever is logged in now. Autostart covers the next login.
    # ---------------------------------------------------------------
    if command -v loginctl >/dev/null 2>&1; then
        while read -r _uid _user _rest; do
            [ -n "$_uid" ] || continue
            [ "$_uid" -ge 1000 ] 2>/dev/null || continue
            [ -d "/run/user/$_uid" ] || continue

            _env="XDG_RUNTIME_DIR=/run/user/$_uid \
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$_uid/bus"

            # Replace a copy left over from an older version.
            runuser -u "$_user" -- env $_env pkill -x predatortune-tray >/dev/null 2>&1 || true
            runuser -u "$_user" -- env $_env setsid /usr/bin/predatortune-tray >/dev/null 2>&1 &
        done < <(loginctl list-users --no-legend 2>/dev/null)
    fi

    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database /usr/share/applications 2>/dev/null || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
    fi

    echo ""
    echo "PredatorTune installed."
    echo "  Fans follow temperature automatically from boot."
    echo "  Curve:  /etc/predatortune/fan.conf"
    echo "  Status: systemctl status predatortune-daemon"
    echo ""
    ;;
esac

exit 0
